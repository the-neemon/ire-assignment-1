# Data and environments — never committed.
.venv/
data/

# Archives and model checkpoints. These only ever land under data/ today, but naming them
# explicitly means one written anywhere else is still caught.
*.zip
*.pt
*.ckpt

# Generated leaderboard predictions: predictions.txt is 671 MB uncompressed. The code that
# builds them is tracked (pipeline/submit.py); the output is not.
deliverable/submissions/

__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# LibreOffice/OpenOffice editing locks, created if a deliverable is opened in an office app.
.~lock.*#

# LaTeX build intermediates. Only the compiled PDF is tracked, because it is the
# graded deliverable; the .tex sources are kept locally (see below) and everything
# xelatex emits alongside them is regenerable and is not tracked.
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz

# Personal study aids, kept locally. docs/NOTES.md is the exception: it is the
# evidence trail the design note's claims rest on, so it ships.
docs/*
!docs/NOTES.md

# Design note: only the final PDF is submitted. The LaTeX sources and the
# single-column variant are kept locally for editing, not tracked.
*.tex
deliverable/design_note_c1_2col.pdf

# Agent instructions and the given assignment brief: not my work product.
CLAUDE.md
brief/
